# ===================================================
#  CẤU HÌNH MÔI TRƯỜNG DỰ ÁN APPBANLE (FILE MẪU)
#  Cách dùng: Sao chép file này thành file ".env" và điền thông tin thật của bạn:
#  cp .env.example .env
# ===================================================

# Cổng khởi chạy backend server
PORT=3000
NODE_ENV=development

# Khóa bí mật dùng để tạo và xác thực JWT token (chuỗi ngẫu nhiên dài)
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# --- CẤU HÌNH DATABASE POSTGRESQL ---
# Cách 1: Sử dụng chuỗi kết nối Cloud (Neon, Render, Supabase, ...)
DATABASE_URL=postgresql://username:password@ep-sample-host.neon.tech/appbanle_db?sslmode=require

# Cách 2: Sử dụng khi chạy PostgreSQL cục bộ trên máy tính (Local Development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appbanle_db
DB_USER=postgres
DB_PASS=your_local_password
